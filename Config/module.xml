<?xml version="1.0" encoding="UTF-8"?>
<!--
    Element order matters: module-2_2.xsd declares an xs:sequence, so fullnamespace, descriptive,
    languages, version, authors, type, required, thelia, stability, mandatory and hidden must
    appear in that order. Note <authors> wrapping <author> — a bare <author> is rejected.
-->
<module xmlns="http://thelia.net/schema/dic/module"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://thelia.net/schema/dic/module http://thelia.net/schema/dic/module/module-2_2.xsd">
    <fullnamespace>PayzenMulti\PayzenMulti</fullnamespace>
    <descriptive locale="en_US">
        <title>Multiple payment for Payzen</title>
    </descriptive>
    <descriptive locale="fr_FR">
        <title>Paiement multiple pour Payzen</title>
    </descriptive>
    <languages>
        <language>en_US</language>
        <language>fr_FR</language>
    </languages>
    <version>2.1.0</version>
    <authors>
        <author>
            <name>Vincent Lopes-Vicente</name>
            <company>OpenStudio</company>
            <email>vlopes@openstudio.fr</email>
        </author>
    </authors>
    <type>payment</type>
    <required>
        <!-- The parent module this one extends: its signatures and configuration are reused.
             Was ">=2.O" (letter O instead of a zero), which no version could ever satisfy. -->
        <module version="&gt;=2.0.0">Payzen</module>
    </required>
    <thelia>3.0.0</thelia>
    <stability>other</stability>
    <mandatory>0</mandatory>
    <hidden>0</hidden>
</module>
