<?xml version="1.0" encoding="UTF-8" ?>

<!--
    Deliberately empty: this module exposes no route.

    It has no configuration screen of its own — everything is configured in Payzen, under
    "Multiple times payment" — and no front-office endpoint, the gateway call going through the
    inherited Payzen implementation.

    Should a route ever be needed: declare it here rather than with a #[Route] attribute if the
    module must keep working on Thelia 2, whose router does not read PHP attributes. Thelia 3
    loads both mechanisms, so declaring a route in both places registers it twice.
-->
<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing http://symfony.com/schema/routing/routing-1.0.xsd">
</routes>
